    "@tauri-apps/plugin-opener": "^2",
    "@types/katex": "^0.16.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide-vue-next": "^0.379.0",
    "marked": "^18.0.10",
