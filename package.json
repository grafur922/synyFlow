{
  "name": "tauri-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:server": "npm --prefix server run start:dev",
    "build": "vue-tsc --noEmit && vite build --configLoader runner",
    "build:server": "npm --prefix server run build",
    "preview": "vite preview",
    "typecheck:server": "npm --prefix server run typecheck",
    "android:reverse": "adb reverse tcp:1420 tcp:1420 && adb reverse tcp:1421 tcp:1421 && adb reverse tcp:3001 tcp:3001 && adb reverse --list",
    "android:dev": "tauri android dev --host 127.0.0.1",
    "tauri": "tauri"
  },
