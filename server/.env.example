# Backend
PORT=3001
TERRA_API_HOST=127.0.0.1
TERRA_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
# Remote binding is disabled by default. A non-loopback host requires both settings below.
TERRA_ALLOW_REMOTE_API=false
TERRA_REQUIRE_API_TOKEN=false
TERRA_API_TOKEN=""
# TERRA_DATA_FILE=C:\path\to\private-data\tasks.json

# Windows-only DPAPI secret file. Use scripts/manage-windows-secrets.ps1 to create it.
# Environment variables above remain the first-priority source when non-empty.
# TERRA_WINDOWS_SECRETS_FILE=C:\path\to\private-data\terra-secrets.json

# Deferred experimental macOS Keychain service; retain for later native platform validation.
# TERRA_MACOS_KEYCHAIN_SERVICE=app.terra-hub.server

# Xiaomi Notes connector (server-side only).
# Copy the complete Cookie request header from your own authenticated i.mi.com session.
# Never expose this value through a VITE_* variable or commit the real server/.env file.
# Leave empty on Windows to enter it securely from the local Xiaomi Notes page.
XIAOMI_CLOUD_COOKIE=""
# Optional safety controls. Read-only mode blocks every Xiaomi mutation before network I/O.
TERRA_XIAOMI_READ_ONLY=false
TERRA_XIAOMI_FAILURE_THRESHOLD=3
TERRA_XIAOMI_CIRCUIT_COOLDOWN_MS=30000
# Structured audit entries are retained in memory. Enable stdout only for a trusted local log sink.
TERRA_XIAOMI_AUDIT_STDOUT=false
# Keep false: an unexpected empty full scan must not tombstone the complete Xiaomi index.
TERRA_XIAOMI_ALLOW_EMPTY_FULL_SYNC=false

# Canonical SQLite history database. Rows are AES-GCM encrypted; keep it outside synced/public folders.
# TERRA_XIAOMI_HISTORY_DB=C:\path\to\private-data\xiaomi-note-history.sqlite
# Legacy JSON source override. TERRA_XIAOMI_HISTORY_FILE remains supported for in-place migration.
# TERRA_XIAOMI_HISTORY_LEGACY_FILE=C:\path\to\private-data\xiaomi-note-history.json

# Preferred for SQLite history; when empty, the shared data key/system data key is used.
# Keep this stable; losing/changing it makes existing encrypted files unreadable.
# Generate a random value in PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
TERRA_HISTORY_ENCRYPTION_KEY=""

# Shared encryption key for Terra metadata, Resource, RSS, blog and travel stores.
# Falls back to TERRA_HISTORY_ENCRYPTION_KEY. Prefer one stable value and back it up securely.
TERRA_DATA_ENCRYPTION_KEY=""
# Encrypted incremental cursors and conflict versions. Defaults beside TERRA_RESOURCE_FILE.
# TERRA_RESOURCE_SYNC_FILE=C:\path\to\private-data\resource-sync.json
# Auto mode runs a full deletion scan after this interval; otherwise it resumes the saved cursor.
TERRA_RESOURCE_XIAOMI_FULL_SCAN_INTERVAL_MS=86400000
# Background Resource sync is opt-in. 0 disables it; positive values are clamped to 1 minute - 24 hours.
TERRA_RESOURCE_SYNC_INTERVAL_MS=0
# TERRA_XIAOMI_METADATA_FILE=C:\path\to\private-data\xiaomi-note-metadata.json
# TERRA_RESOURCE_FILE=C:\path\to\private-data\resources.json

# RSS encrypted state and scheduler
# TERRA_RSS_FILE=C:\path\to\private-data\rss.json
TERRA_RSS_SCHEDULER_ENABLED=true
TERRA_RSS_ALLOWED_PORTS=80,443
# Keep false in production. Enable only when intentionally subscribing to trusted LAN feeds.
TERRA_RSS_ALLOW_PRIVATE_NETWORKS=false

# Personal blog encrypted drafts and Markdown publishing adapter
# TERRA_BLOG_FILE=C:\path\to\private-data\blog.json
# Point this at a Hugo/Hexo/Jekyll content/posts directory.
TERRA_BLOG_CONTENT_DIR=""

# Travel planner encrypted state
# TERRA_TRAVEL_FILE=C:\path\to\private-data\travel.json
# Row-encrypted attachment SQLite. Requires the shared data key and is included in server backups.
# TERRA_TRAVEL_ATTACHMENTS_DB=C:\path\to\private-data\travel-attachments.sqlite

# RAG encrypted documents, chunks and local retrieval index
# TERRA_RAG_FILE=C:\path\to\private-data\rag.json
# Optional per-query external rerank/generation. Local remains the default and secret/flagged/high-sensitive content is never sent.
# TERRA_RAG_EXTERNAL_PROVIDER=openai-compatible
# TERRA_RAG_EXTERNAL_BASE_URL=https://api.openai.com/v1
# TERRA_RAG_EXTERNAL_ALLOWED_HOSTS=api.openai.com
# TERRA_RAG_EXTERNAL_API_KEY=
# TERRA_RAG_EXTERNAL_EMBEDDING_MODEL=
# TERRA_RAG_EXTERNAL_ANSWER_MODEL=
# HTTP loopback providers are test/local-development only and require this explicit switch.
TERRA_RAG_EXTERNAL_ALLOW_LOOPBACK=false

# Offline encrypted backups created by scripts/terra-backup.cjs
# TERRA_BACKUP_DIR=C:\path\to\private-backups
